# OpenMetadata
OPENMETADATA__API_URL=https://data-catalog-dev.wb.ru/api
OPENMETADATA__API_VERSION=v1
OPENMETADATA__TOKEN=<token>

# Trino connection
TRINO__HOST=dto-trino.wildberries.ru
TRINO__PORT=443
TRINO__USER=<username>

# S3-compatible endpoint
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=dto-sample-data
S3_USE_SSL=false
